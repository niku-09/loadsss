Option Explicit

' ============================================================
'  Wind load auto-selection (Wx / Wy) - staged
'  Stage0  config
'  Stage0b API probe  <-- RUN THIS FIRST
'  Stage1  diagnostic scan (no model changes)
'  Stage2  build matched set + tributary areas
'  Stage3  apply nodal forces
' ============================================================

' ---- ALL module-level declarations at top ----
Dim TARGET_AXIS As Integer
Dim TARGET_SIGN As Integer
Dim ANGLE_TOL_DEG As Double
Dim LOAD_SET_ID As Long
Dim TOTAL_FORCE As Double
Dim LOG_PATH As String

Dim matchedElemIDs() As Long
Dim nMatchedElems As Long
Dim nodeArea As Object
Dim configDone As Boolean
Dim stage2Done As Boolean

Const WX_FORCE As Double = 665552.8
Const WY_FORCE As Double = 397276.8
Const FE_OK As Integer = -1
Const PLATE_TYPE As Integer = 8      ' UNVERIFIED - Stage0b will tell you the real value


Sub Main()
    Stage0_Config
    MsgBox "Config loaded." & vbCrLf & vbCrLf & _
           "Now run Stage0b_ApiProbe from the Sub list to verify " & _
           "element type and node-list access before anything else."
End Sub


' ============================================================
Sub Stage0_Config()
    Dim resp As String

    resp = InputBox("Target axis  (X = along rail / Wx,  Y = across rail / Wy)", "Axis", "X")
    If UCase(resp) = "X" Then
        TARGET_AXIS = 1
        TOTAL_FORCE = WX_FORCE
        LOAD_SET_ID = 9
    Else
        TARGET_AXIS = 2
        TOTAL_FORCE = WY_FORCE
        LOAD_SET_ID = 10
    End If

    resp = InputBox("Windward face normal sign  (+1 or -1)", "Side", "-1")
    TARGET_SIGN = CInt(resp)

    resp = InputBox("Angle tolerance from axis, degrees", "Tolerance", "30")
    ANGLE_TOL_DEG = CDbl(resp)

    resp = InputBox("Load Set ID", "Load Set", CStr(LOAD_SET_ID))
    LOAD_SET_ID = CLng(resp)

    LOG_PATH = "C:\FEMAP_Automation\WindSelect_" & Format(Now, "yyyymmdd_hhnnss") & ".log"
    configDone = True
End Sub


' ============================================================
'  Stage0b - dump raw API data for the first 15 elements so we can
'  confirm the type constant and how to read the node list.
'  Makes NO changes to the model.
' ============================================================
Sub Stage0b_ApiProbe()
    Dim App As femap.model
    Set App = feFemap

    Dim oElem As femap.Elem
    Set oElem = App.feElem

    Dim msg As String
    Dim count As Integer
    count = 0

    msg = "ID / type / topology / first node IDs" & vbCrLf & vbCrLf

    If oElem.First = FE_OK Then
        Do
            count = count + 1

            Dim v As Variant
            Dim nodeStr As String
            Dim i As Integer

            nodeStr = ""
            On Error Resume Next
            v = oElem.vnode
            If Err.Number = 0 Then
                For i = 0 To 7
                    nodeStr = nodeStr & CStr(v(i)) & " "
                Next i
            Else
                nodeStr = "<vnode failed: " & Err.Description & ">"
                Err.Clear
            End If
            On Error GoTo 0

            msg = msg & oElem.ID & " / " & oElem.type & " / " & _
                  oElem.topology & " / " & nodeStr & vbCrLf

            If count >= 15 Then Exit Do
        Loop While oElem.Next = FE_OK
    End If

    MsgBox msg
End Sub


' ============================================================
'  Newell's method face normal.  nodeIDs must be a DYNAMIC array.
' ============================================================
Function GetElemNormal(nodeIDs() As Long, nCount As Integer, App As femap.model, _
                       ByRef nx As Double, ByRef ny As Double, ByRef nz As Double) As Boolean

    Dim oNode As femap.Node
    Set oNode = App.feNode

    Dim px(1 To 4) As Double
    Dim py(1 To 4) As Double
    Dim pz(1 To 4) As Double
    Dim i As Integer
    Dim j As Integer

    For i = 1 To nCount
        If oNode.Get(nodeIDs(i)) <> FE_OK Then
            GetElemNormal = False
            Exit Function
        End If
        px(i) = oNode.x
        py(i) = oNode.y
        pz(i) = oNode.z
    Next i

    nx = 0
    ny = 0
    nz = 0

    For i = 1 To nCount
        j = (i Mod nCount) + 1
        nx = nx + (py(i) - py(j)) * (pz(i) + pz(j))
        ny = ny + (pz(i) - pz(j)) * (px(i) + px(j))
        nz = nz + (px(i) - px(j)) * (py(i) + py(j))
    Next i

    Dim mag As Double
    mag = Sqr(nx * nx + ny * ny + nz * nz)

    If mag < 0.000001 Then
        GetElemNormal = False
    Else
        nx = nx / mag
        ny = ny / mag
        nz = nz / mag
        GetElemNormal = True
    End If
End Function


' ============================================================
Function ElemFaceArea(nodeIDs() As Long, nCount As Integer, App As femap.model) As Double
    Dim oNode As femap.Node
    Set oNode = App.feNode

    Dim px(1 To 4) As Double
    Dim py(1 To 4) As Double
    Dim pz(1 To 4) As Double
    Dim i As Integer

    For i = 1 To nCount
        If oNode.Get(nodeIDs(i)) <> FE_OK Then
            ElemFaceArea = 0
            Exit Function
        End If
        px(i) = oNode.x
        py(i) = oNode.y
        pz(i) = oNode.z
    Next i

    Dim sx As Double
    Dim sy As Double
    Dim sz As Double
    Dim ax As Double
    Dim ay As Double
    Dim az As Double
    Dim bx As Double
    Dim by As Double
    Dim bz As Double

    sx = 0
    sy = 0
    sz = 0

    For i = 2 To nCount - 1
        ax = px(i) - px(1)
        ay = py(i) - py(1)
        az = pz(i) - pz(1)
        bx = px(i + 1) - px(1)
        by = py(i + 1) - py(1)
        bz = pz(i + 1) - pz(1)
        sx = sx + (ay * bz - az * by)
        sy = sy + (az * bx - ax * bz)
        sz = sz + (ax * by - ay * bx)
    Next i

    ElemFaceArea = 0.5 * Sqr(sx * sx + sy * sy + sz * sz)
End Function


' ============================================================
Sub Stage1_Diagnostic()
    If Not configDone Then
        MsgBox "Run Stage0_Config first."
        Exit Sub
    End If

    Dim App As femap.model
    Set App = feFemap
    Dim oElem As femap.Elem
    Set oElem = App.feElem

    Dim cosTol As Double
    cosTol = Cos(ANGLE_TOL_DEG * 3.14159265 / 180)

    Dim nodeIDs() As Long
    ReDim nodeIDs(1 To 4)

    Dim fnum As Integer
    fnum = FreeFile
    Open LOG_PATH For Output As #fnum
    Print #fnum, "ElemID" & vbTab & "nx" & vbTab & "ny" & vbTab & "nz" & vbTab & "Matched"

    Dim nTotal As Long
    Dim nMatched As Long
    Dim nSkippedType As Long
    Dim nBadNormal As Long
    Dim nNodes As Integer
    Dim nx As Double
    Dim ny As Double
    Dim nz As Double
    Dim comp As Double
    Dim isMatch As Boolean
    Dim v As Variant
    Dim k As Integer

    nTotal = 0
    nMatched = 0
    nSkippedType = 0
    nBadNormal = 0

    If oElem.First = FE_OK Then
        Do
            nTotal = nTotal + 1

            If oElem.type = PLATE_TYPE Then
                v = oElem.vnode

                nNodes = 4
                If v(3) = 0 Then nNodes = 3

                ReDim nodeIDs(1 To nNodes)
                For k = 1 To nNodes
                    nodeIDs(k) = CLng(v(k - 1))
                Next k

                If GetElemNormal(nodeIDs, nNodes, App, nx, ny, nz) Then
                    If TARGET_AXIS = 1 Then
                        comp = nx
                    Else
                        comp = ny
                    End If

                    isMatch = False
                    If TARGET_SIGN > 0 Then
                        If comp >= cosTol Then isMatch = True
                    Else
                        If comp <= -cosTol Then isMatch = True
                    End If

                    Print #fnum, oElem.ID & vbTab & Format(nx, "0.000") & vbTab & _
                                 Format(ny, "0.000") & vbTab & Format(nz, "0.000") & _
                                 vbTab & isMatch

                    If isMatch Then nMatched = nMatched + 1
                Else
                    nBadNormal = nBadNormal + 1
                End If
            Else
                nSkippedType = nSkippedType + 1
            End If
        Loop While oElem.Next = FE_OK
    End If

    Close #fnum

    MsgBox "Total elements scanned: " & nTotal & vbCrLf & _
           "Matched (windward): " & nMatched & vbCrLf & _
           "Skipped (wrong type): " & nSkippedType & vbCrLf & _
           "Degenerate normal: " & nBadNormal & vbCrLf & vbCrLf & _
           "Log: " & LOG_PATH
End Sub
